# Copy this file to .env and fill in values you have.
# The app runs without these keys; unconfigured integrations stay mock
# and never report a message or call as sent.

APP_NAME=Smart Kitchen AI
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:8501
DATABASE_URL=sqlite:///./data/smartkitchen.db
TIMEZONE=Asia/Kolkata

# ── Google Gemini (PRIMARY AI provider, free tier available) ──────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── OpenAI (LEGACY, optional — Gemini is preferred) ──────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── WhatsApp Business Cloud API ───────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=smartkitchen-verify

# ── Exotel outbound voice ─────────────────────────────────────────────────────
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_APP_ID=
EXOTEL_STATUS_CALLBACK_URL=
